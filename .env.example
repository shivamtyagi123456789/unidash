NODE_ENV=development
TZ=Asia/Kolkata
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false
LOG_LEVEL=info

# Use a local PostgreSQL database or a private managed PostgreSQL instance.
# Never commit a real connection string here.
DATABASE_URL=postgresql://unidash:replace-me@localhost:5432/unidash
WORKER_DATABASE_URL=postgresql://unidash_worker:replace-me@localhost:5432/unidash

# Create an OAuth web client in Google Cloud Console; keep these values private.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OWNER_EMAIL=

# Storage files live in the owner's Google Drive via a separate drive.file consent.
# Add http://localhost:3000/api/v1/storage/drive/callback as a Google OAuth redirect URI.
# Generate a private 32-byte key, base64-encode it, and keep it outside source control.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# VAULT_MASTER_KEY=

# AMS and Moodle are accessed by the paired browser extension using the user's
# signed-in Edge session. UniDash does not need portal tokens or portal host secrets.
